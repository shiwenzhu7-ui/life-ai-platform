# LifeAI 后端配置模板：复制为 .env 后填写真实值
#     Copy-Item .env.example .env
# 注意：.env 已被 .gitignore 排除，密钥永远不要提交。
#
# 规则（core/config.py）：
#   1. 本文件里的键名必须和 Settings 的字段**一一对应**（大小写不敏感）。
#      代码里没有的键写了也不会生效，只会误导下一个读它的人。
#   2. 改动 .env 之后必须**重启** uvicorn —— settings 有 lru_cache，
#      --reload 只监听 .py，不会因为 .env 变化而重载。
#   3. 注释里的「默认值」是代码里的兜底值，.env 里写什么就以什么为准。

# ---------- 应用 ----------
APP_NAME=LifeAI
APP_ENV=dev
DEBUG=true
PORT=8000
API_V1_PREFIX=/api/v1

# ---------- 数据库 ----------
# 必填，没有默认值：缺失时 core/db.py 会在导入阶段直接报错，而不是连一个假库
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/lifeai?charset=utf8mb4

# ---------- 跨域 ----------
# 逗号分隔。三个前端分别跑在 8080 / 8081 / 8082，localhost 与 127.0.0.1 要各写一份：
# 浏览器认为这是两个不同的源，只写一个，用另一个访问时会被 CORS 拦下。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# ---------- 认证（V1.2 启用） ----------
# 必填。生成一个 32 字节以上的随机串，例如：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时 core/security.py 会拒绝签发令牌（启动后登录直接 500 并说明原因），
# 这是故意的：拿空串签出的令牌任何人都能伪造。
JWT_SECRET=
# 只允许对称算法。V2.0 换 Keycloak 时改成 RS256 + JWKS 公钥验签
JWT_ALGORITHM=HS256
# 令牌有效期（分钟）。接口返回的 expires_in = 本值 × 60
JWT_EXPIRE_MINUTES=120

# ---------- LLM（V1.1 AI 助手） ----------
# 任何 OpenAI 兼容端点都行（DeepSeek / 千问 / 本地 vLLM …）：
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com
#              LLM_MODEL=deepseek-chat
#   千问       LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode
#              LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
# 末尾不要带 /v1（代码会拼 /chat/completions）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 计价单价（元 / 百万 token），用来估 ai_usage_logs.cost_estimate。
# 默认 0 = 只记 token 不估钱 —— 没核实过官网价目表就填数字，记出来的是假账。
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0

# 工具调用总开关。关掉后退回「纯聊天」：请求里不发 tools、提示词里不讲工具规则。
# 一句 LLM_TOOLS_ENABLED=false 就能把「AI 乱建待办」这类事故刹住，不用回滚代码。
LLM_TOOLS_ENABLED=true