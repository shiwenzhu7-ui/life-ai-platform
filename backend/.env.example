# LifeAI 后端配置模板：复制为 .env 后填写真实值
# 注意：.env 已被 .gitignore 排除，密钥永远不要提交

# ---------- 应用 ----------
APP_NAME=LifeAI
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---------- 数据库 ----------
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/lifeai?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# ---------- 认证（V1.2 启用） ----------
JWT_SECRET=请替换为随机32位以上字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---------- AI（V1.1 启用） ----------
AI_CHAT_PROVIDER=deepseek
AI_CHAT_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-请替换
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ---------- Embedding（V1.3 启用） ----------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_DEVICE=cpu

# ---------- Milvus（V1.3 启用） ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=lifeai_chunks

# ---------- 上传（V1.3 启用） ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
ALLOWED_EXT=pdf,docx,txt

# ---------- Keycloak（V2.0 启用） ----------
KEYCLOAK_SERVER_URL=http://localhost:8083
KEYCLOAK_REALM=lifeai
KEYCLOAK_CLIENT_ID=life-web
KEYCLOAK_JWKS_URL=http://localhost:8083/realms/lifeai/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=life-web
