# LifeAI 后端配置模板：复制为 .env 后填写真实值
#     Copy-Item .env.example .env
# 注意：.env 已被 .gitignore 排除，密钥永远不要提交。
#
# 规则（core/config.py）：
#   1. 本文件里的键名必须和 Settings 的字段**一一对应**（大小写不敏感）。
#      代码里没有的键写了也不会生效，只会误导下一个读它的人。
#   2. 改动 .env 之后必须**重启** uvicorn —— settings 有 lru_cache，
#      --reload 只监听 .py，不会因为 .env 变化而重载。
#   3. 注释里的「默认值」是代码里的兜底值，.env 里写什么就以什么为准。

# ---------- 应用 ----------
APP_NAME=LifeAI
APP_ENV=dev
DEBUG=true
PORT=8000
API_V1_PREFIX=/api/v1

# ---------- 数据库 ----------
# 必填，没有默认值：缺失时 core/db.py 会在导入阶段直接报错，而不是连一个假库
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/lifeai?charset=utf8mb4

# ---------- 跨域 ----------
# 逗号分隔。三个前端分别跑在 8080 / 8081 / 8082，localhost 与 127.0.0.1 要各写一份：
# 浏览器认为这是两个不同的源，只写一个，用另一个访问时会被 CORS 拦下。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# ---------- 认证（V1.2 启用） ----------
# 必填。生成一个 32 字节以上的随机串，例如：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时 core/security.py 会拒绝签发令牌（启动后登录直接 500 并说明原因），
# 这是故意的：拿空串签出的令牌任何人都能伪造。
JWT_SECRET=
# 只允许对称算法。V2.0 换 Keycloak 时改成 RS256 + JWKS 公钥验签
JWT_ALGORITHM=HS256
# 令牌有效期（分钟）。接口返回的 expires_in = 本值 × 60
JWT_EXPIRE_MINUTES=120

# ---------- LLM（V1.1 AI 助手） ----------
# 任何 OpenAI 兼容端点都行（DeepSeek / 千问 / 本地 vLLM …）：
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com
#              LLM_MODEL=deepseek-chat
#   千问       LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
#              LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
# 代码只在这后面拼 /chat/completions，所以这里的路径要和厂商的 OpenAI
# 兼容前缀**完全对上**：DeepSeek 没有 /v1，千问必须有 /v1。
# 写错了的表现是 POST 成功但上游回 404 → 接口返回 502 UPSTREAM「模型服务返回 HTTP 404」。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 计价单价（元 / 百万 token），用来估 ai_usage_logs.cost_estimate。
# 默认 0 = 只记 token 不估钱 —— 没核实过官网价目表就填数字，记出来的是假账。
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0

# 工具调用总开关。关掉后退回「纯聊天」：请求里不发 tools、提示词里不讲工具规则。
# 一句 LLM_TOOLS_ENABLED=false 就能把「AI 乱建待办」这类事故刹住，不用回滚代码。
LLM_TOOLS_ENABLED=true

# ---------- 知识库 / RAG（V1.3） ----------
# Milvus standalone 跑在虚拟机里（Windows 上没装 docker，Milvus 常驻要 1–2GB）。
# 虚拟机 IP 在 VMware 里是 DHCP 分配的，换网络或重启后可能变 —— 变了就改这里。
# 连通性自查：curl http://<虚拟机IP>:9091/healthz 应返回 OK。
VECTOR_URI=http://192.168.88.134:19530
VECTOR_DB=lifeai
VECTOR_COLLECTION=kb_chunks

# 嵌入模型。默认的 bge-small-zh-v1.5 是 512 维，ONNX 权重 90MB。
# 换模型必须同时改 EMBEDDING_DIM，且要重建集合 —— 维度不同写不进去。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 权重缓存目录。留空用 fastembed 默认位置；本机权重在 D 盘就指过去，避免往 C 盘再下载一份。
EMBEDDING_CACHE_DIR=D:\developTools\fastembed_cache
# 启动后常驻推理会话：首次检索不用等 0.4s 加载，代价是几十 MB 内存。
EMBEDDING_WARMUP=true

# ---------- 文档切分 ----------
# 按字符数切（中文按字比分词稳妥），512 字一段、相邻段重叠 64 字避免把句子切断。
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=64
# 单文件上传上限，20MB
KB_MAX_UPLOAD_BYTES=20971520
# 每次检索返回的片段数
KB_TOP_K=5

# ---------- SSO / OIDC（V2.0） ----------
# Keycloak 跑在虚拟机里，容器把 8080 映射到宿主机的 8180：
#     docker run -d --name keycloak -p 8180:8080 ... quay.io/keycloak/keycloak:26.4.0 start-dev
# 域名/端口变了就改 OIDC_ISSUER，其余端点由 {issuer}/protocol/openid-connect/* 推出来。
#
# 三个都留空 = 不启用 SSO：/auth/sso/login 返回 503，账号密码登录照常可用。
#
# 末尾**不要**带斜杠：代码按 f"{issuer}/protocol/..." 拼端点，多一个斜杠就是 // 404。
OIDC_ISSUER=http://192.168.88.134:8180/realms/lifeai
# Keycloak 控制台 → 客户 → life-web 里的「客户端 ID」
OIDC_CLIENT_ID=life-web
# 同上，在「资历（Credentials）」标签页里，值只放这里，绝不进 git/日志/响应体
OIDC_CLIENT_SECRET=
# 后端回调地址，必须与 Keycloak「有效的重定向URI」里那条逐字一致，
# 否则 Keycloak 直接拒绝跳转并报 Invalid parameter: redirect_uri
OIDC_REDIRECT_URI=http://localhost:8010/api/v1/auth/sso/callback
# 换完本地 JWT 后把浏览器送回的前端页面：前端在那里读 ?token= 存起来再跳首页
OIDC_FRONTEND_CALLBACK=http://localhost:8080/sso/callback
# state / code_verifier / nonce 的临时容器（HttpOnly Cookie，JS 读不到）
OIDC_COOKIE_NAME=lifeai_sso_state
# 单位秒。这段时间内必须完成「跳转 Keycloak + 输密码 + 回调」，
# 超时就是「登录超时，请重试」—— 正常手速 20 秒内够用
OIDC_COOKIE_MAX_AGE=600

# ---------- 管理后台分级（V1.4） ----------
# 根管理员（第一级）的 user_id。只有这个人能授予/撤销管理员，且任何人都改不了他。
# 留空（0）= 自动取 users 表里 id 最小的 role=admin，老库不用改配置就能用。
# 建议定下来之后在这里钉死，否则「把一个 id 更小的用户提成 admin」会悄悄换掉根。
# 想换根只能改这里（或直接改库），后台界面没有这个口子。
ADMIN_ROOT_USER_ID=0